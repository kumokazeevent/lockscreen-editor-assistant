{
  "manifest_version": 3,
  "name": "锁屏编辑助手",
  "version": "0.5.3",
  "description": "保持原稿语言优化标题与简介，并按原标题自动搜索可商用竖图的常驻助手。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "显示或隐藏锁屏编辑助手"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "assistant.js"
      ],
      "css": [
        "content.css",
        "assistant.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}

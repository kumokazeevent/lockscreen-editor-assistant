{
  "manifest_version": 3,
  "name": "锁屏编辑助手",
  "version": "0.7.6",
  "description": "为锁屏内容后台批量改写多语言标题与简介、搜索竖屏商用图片并辅助真实上传。",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "显示或隐藏锁屏编辑助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lockscreen-admin.mofeeds.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lockscreen-admin.mofeeds.com/*"
      ],
      "js": [
        "content.js",
        "assistant.js"
      ],
      "css": [
        "content.css",
        "assistant.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
